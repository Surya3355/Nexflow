# Nexflow environment variables. Names only. Copy to .env (git-ignored) and fill in values.
# docker-compose.yml reads NEXFLOW_LINK_SECRET from here. Replace the example value:
# the server refuses to start with it. Make one with: openssl rand -hex 32
NEXFLOW_LINK_SECRET=change-me-to-32-or-more-random-characters

# Used by the Go binary when run outside Docker (see docs/local-testing.md).
NEXFLOW_DB_URL=
NEXFLOW_HTTP_ADDR=:8080
NEXFLOW_TEST_DB_URL=
NEXFLOW_UPLOAD_DIR=uploads
NEXFLOW_INSECURE_COOKIES=true
# Only when the API is reachable through nginx alone: the login limit then reads
# the client address from nginx's X-Real-IP header.
NEXFLOW_TRUST_PROXY=
# Other sites allowed to send changes (comma separated), e.g. a dev server on
# another port. The app's own address is always allowed.
NEXFLOW_ALLOWED_ORIGINS=

# Not wired yet (hosting and email are blocked until the owner chooses providers).
NEXFLOW_SMTP_HOST=
NEXFLOW_SMTP_PORT=
NEXFLOW_SMTP_USER=
NEXFLOW_SMTP_PASSWORD=
NEXFLOW_SMTP_FROM=
