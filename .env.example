# Nexflow environment variables. Names only. Copy to .env (git-ignored) and fill in values.
# docker-compose.yml reads NEXFLOW_LINK_SECRET from here. Local run only.
NEXFLOW_LINK_SECRET=change-me-to-32-or-more-random-characters

# Used by the Go binary when run outside Docker (see docs/local-testing.md).
NEXFLOW_DB_URL=
NEXFLOW_HTTP_ADDR=:8080
NEXFLOW_TEST_DB_URL=
NEXFLOW_UPLOAD_DIR=uploads
NEXFLOW_INSECURE_COOKIES=true

# Not wired yet (hosting and email are blocked until the owner chooses providers).
NEXFLOW_SMTP_HOST=
NEXFLOW_SMTP_PORT=
NEXFLOW_SMTP_USER=
NEXFLOW_SMTP_PASSWORD=
NEXFLOW_SMTP_FROM=
